{
  "name": "@spritecollab/optimizer",
  "version": "1.0.0",
  "private": true,
  "description": "Packs the SpriteCollab sprite folders into compact, deduplicated sheets",
  "license": "CC-BY-NC-4.0",
  "type": "module",
  "bin": {
    "sprite-optimize": "./src/bin.ts",
    "sprite-status": "./src/status-bin.ts",
    "sprite-recolor": "./src/recolor-bin.ts"
  },
  "scripts": {
    "optimize": "node src/bin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "status": "node src/status-bin.ts",
    "recolor": "node src/recolor-bin.ts"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
